local labelCorner = Instance.new("UICorner")
labelCorner.CornerRadius = UDim.new(0, 6)
labelCorner.Parent = idLabel


-- 2. XỬ LÝ LẮNG NGHE ANIMATION
local function setupAnimationListener(character)
	local humanoid = character:WaitForChild("Humanoid", 5)
	if not humanoid then return end
	
	local animator = humanoid:WaitForChild("Animator", 5)
	if not animator then return end

	-- Ngắt kết nối cũ nếu có
	if animationConnection then
		animationConnection:Disconnect()
		animationConnection = nil
	end

	-- Lắng nghe khi animation mới bắt đầu chạy
	animationConnection = animator.AnimationPlayed:Connect(function(track)
		if isDetecting and track.Animation then
			local animId = track.Animation.AnimationId
			idLabel.Text = animId
			print("[Anim Detector] ID: " .. animId)
		end
	end)
end

-- Tải lại sự kiện khi Character hồi sinh (Respawn)
if localPlayer.Character then
	setupAnimationListener(localPlayer.Character)
end

localPlayer.CharacterAdded:Connect(function(newCharacter)
	setupAnimationListener(newCharacter)
end)


-- 3. XỬ LÝ SỰ KIỆN NÚT BẬT / TẮT
toggleButton.MouseButton1Click:Connect(function()
	isDetecting = not isDetecting
	
	if isDetecting then
		toggleButton.Text = "Bật phát hiện Animation: ON"
		toggleButton.BackgroundColor3 = Color3.fromRGB(40, 190, 40)
		idLabel.Text = "Đang chờ phát hiện Animation..."
	else
		toggleButton.Text = "Bật phát hiện Animation: OFF"
		toggleButton.BackgroundColor3 = Color3.fromRGB(190, 40, 40)
		idLabel.Text = "Đã tắt phát hiện."
	end
end)
